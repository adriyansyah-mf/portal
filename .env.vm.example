# Public DNS name that points to this VM. Do not include https:// or a path.
PORTAL_DOMAIN=wifi.clairty.example

# RouterOS HTTPS origin, reachable from the VM. Do not include /rest.
MIKROTIK_URL=https://router.clairty.example
MIKROTIK_USERNAME=clairty-portal
MIKROTIK_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Leave empty when RouterOS uses a publicly trusted certificate.
# For a private CA, copy its PEM file to certs/router-ca.pem and use:
NODE_EXTRA_CA_CERTS=/certs/router-ca.pem
